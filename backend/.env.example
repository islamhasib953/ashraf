# ===========================================
# AI Agent SaaS Platform - Environment Config
# ===========================================
# Copy this file to .env and fill in your values

# --- Application ---
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Database ---
DATABASE_URL=sqlite:///./agent_saas.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Frontend URL) ---
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins. Add your production web URL here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local: http://localhost:11434. Docker Compose overrides this for containers.
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: OpenAI (users can override with their own key in the UI) ---
OPENAI_API_KEY=

# --- Optional: Default Telegram Bot Token ---
TELEGRAM_BOT_TOKEN=

# --- Email (SMTP) Defaults ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- HuggingFace Local Model ---
# Model is downloaded automatically on first run
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DB_PATH=./chroma_db

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
FERNET_KEY=sVSwcO7LCodpjCZPPCnXHM12JgNm3CTBvVZcMNIKjos=
