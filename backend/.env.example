# ===========================================
# AI Agent SaaS Platform - Environment Config
# ===========================================
# Copy this file to .env and fill in your values

# --- Application ---
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FERNET_KEY=your-fernet-encryption-key-generate-with-Fernet.generate_key()

# --- Database ---
DATABASE_URL=postgresql://saas_user:saas_password@localhost:5432/agent_saas_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Frontend URL) ---
FRONTEND_URL=http://localhost:3000

# --- Optional: OpenAI (users can override with their own key in the UI) ---
OPENAI_API_KEY=

# --- Optional: Default Telegram Bot Token ---
TELEGRAM_BOT_TOKEN=

# --- Email (SMTP) Defaults ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- HuggingFace Local Model ---
# Model is downloaded automatically on first run
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DB_PATH=./chroma_db

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
